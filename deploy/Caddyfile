{
	email {$ACME_EMAIL}
	# Clients keep their HTTPS connection for 55 min between requests (client api.rs POOL_IDLE):
	# a new one costs two round trips. Caddy's default would close it after 5 min.
	servers {
		timeouts {
			idle 60m
		}
	}
}

{$PULSE_DOMAIN} {
	# LiveKit posts its webhooks over loopback; nobody on the internet needs this path.
	respond /livekit/webhook* 404
	reverse_proxy 127.0.0.1:7890
}

voice.{$PULSE_DOMAIN} {
	reverse_proxy 127.0.0.1:7880
}
