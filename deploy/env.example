# /srv/pulse/.env: settings and secrets for the Pulse server (mode 600, owned by pulse).
# setup.sh creates it from this file and fills in the generated values; edit the blanks by hand.
PULSE_DOMAIN=pulsechat.co.za
# Image tag to run (for humans); `just deploy <sha>` rewrites this line.
PULSE_TAG=latest
# Exact image to run, tag plus digest. deploy.sh writes it (appends it if missing); leave it blank here.
# When blank, compose falls back to PULSE_TAG.
PULSE_IMAGE=
# Containers run as the host `pulse` user (setup.sh fills these in).
PULSE_UID=
PULSE_GID=
# Let's Encrypt account email (Greg's personal address).
ACME_EMAIL=
# Shared by LiveKit and the Pulse server (setup.sh generates it).
LIVEKIT_SECRET=
# The server's public IPv4 (the address the two DNS A records point at). LiveKit advertises it to clients
# instead of asking third-party STUN servers for it. Fill it in by hand; deploy.sh refuses to run without it.
LIVEKIT_NODE_IP=
# Backups (deploy/README.md, "Backups"). Left empty, the nightly job skips itself.
AGE_RECIPIENT=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
