{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse",
  "mainBinaryName": "pulse-app",
  "identifier": "app.pulse.client",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --dir ui dev",
    "beforeBuildCommand": "pnpm --dir ui build",
    "windows": {
      "staticVCRuntime": false
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: pulse-media: http://pulse-media.localhost asset: http://asset.localhost https://*.giphy.com; media-src 'self' mediastream: blob: asset: http://asset.localhost https://*.r2.cloudflarestorage.com; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost wss://voice.pulsechat.co.za https://voice.pulsechat.co.za; frame-src https://pulsechat.co.za",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyMDA4NkU3MzgzM0MxMEYKUldRUHdUTTQ1NFlBd2g0T1RTd0VGS29ldWpZSGU0M1BPSGlCNSs3ZUxFZWxJQkZ3OHBzUnlNb0gK",
      "endpoints": ["https://pulsechat.co.za/updates/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../../THIRD_PARTY.md": "THIRD_PARTY.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
